  199:                                 ; init_memory_region
  200:                                 ;   analysis [high]: Generic register initialiser. Y points at (offset,value) byte pairs and each value is written
  201:                                 ;        to [X+offset]. Stops when the next offset is 0 (only the first entry may use offset 0).
  202:                                 ;   OBD1 _init_memory_region (match 1.00 p1-exact)
  203:                                 ;   called from: init_IOR_registers_59DD, Main_task_scheduler
  204:                                 ; ----------------------------------------------------------------------------
