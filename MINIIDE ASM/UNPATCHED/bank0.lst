 6134:     8018 7D 1974                        tst >COUNTER_32HZ                   ; 8018  7D 19 74      test COUNTER_32HZ
 6135:     801B 26 03                          bne loc_8020                        ; 801B  26 03         if COUNTER_32HZ != 0 goto loc_8020
