18655:                                 ; ----------------------------------------------------------------------------
18656:                                 ; PCS_duty_from_pressure
18657:                                 ;   Builds the IOR 1809 duty (TCC PWM solenoid on this board) from the pressure-style command via curves
18658:                                 ;        4585/45A7; 0 when the TCC is forced off. "PCS" in the name is probably wrong.
18659:                                 ;   analysis [medium]: Converts line_pressure_desired (clamped to $60, /3 into curve index) into PCS_duty_cmd.
18660:                                 ;        Uses curve tbl_TRANS_PCS_duty_curve_4585, corrected by the term (k_4584 - duty)*[$1AF5] and a fdiv
18661:                                 ;        against curve 45A7, +0.5 rounding, clamped to $FF. Forces duty 0 when DS_TCCMODE b0/b1 are set and $1AF5
18662:                                 ;        is 0.
18663:                                 ;   called from: Central_Scheduler
18664:                                 ; ----------------------------------------------------------------------------
18665:     D626                        PCS_duty_from_pressure:
18666:     D626 13 7A 03 08                    brclr <DS_TCCMODE,$03,loc_D632      ; D626  13 7A 03 08   if DS_TCCMODE .0 TCC IS BEING FORCED OFF,.1 TCC ENABLE SOLENOID VALID clear goto loc_D632
18667:     D62A FC 1AF5                        ldd >TCC_PWM_duty_cmd               ; D62A  FC 1A F5      D = TCC_PWM_duty_cmd
18668:     D62D 26 03                          bne loc_D632                        ; D62D  26 03         if D != 0 goto loc_D632
18669:     D62F 4F                             clra                                ; D62F  4F            A = 0
