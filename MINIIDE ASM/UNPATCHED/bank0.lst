 7881:     8C29 FC 1A21                        ldd >ENGINE_RUN_TIME                ; 8C29  FC 1A 21      D = ENGINE_RUN_TIME | learn enable: run time > CAL_DRAG_ADAPT_MINRUNTM, idle target unchanged, RPM within +/-MAXRPMERR
 7882:     8C2C 1AB3 230F                      cpd >CAL_DRAG_ADAPT_MINRUNTM        ; 8C2C  1A B3 23 0F   compare D with CAL_DRAG_ADAPT_MINRUNTM
