14269:     B805 C9 00                          adcb #$00                           ; B805  C9 00         B += C + 0
14270:     B807 89 00                          adca #$00                           ; B807  89 00         A += C + 0
14271:     B809                        loc_B809:
14272:     B809 FE 1B01                        ldx >TCC_slip_speed                 ; B809  FE 1B 01      X = TCC_slip_speed | filter TC slip (engine - turbine?) with coef tbl_3891 -> $1B01, abs -> $1AFD
14273:     B80C 18CE 3891                      ldy #k_TC_slip_filter_3891          ; B80C  18 CE 38 91   Y = &k_TC_slip_filter_3891
14274:     B810 BD 666F                        jsr >FILTER2                        ; B810  BD 66 6F      call FILTER2
14275:     B813 FD 1B01                        std >TCC_slip_speed                 ; B813  FD 1B 01      TCC_slip_speed = D
14276:     B816 2A 04                          bpl loc_B81C                        ; B816  2A 04         if D >= 0 (signed) goto loc_B81C
14277:     B818 40                             nega                                ; B818  40            A = -A
