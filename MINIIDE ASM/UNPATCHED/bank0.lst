21758:                                 ; ----------------------------------------------------------------------------
21759:                                 ; select_ptr_by_gear_flags_EBF2
21760:                                 ;   analysis [high]: OBD1 LA444. Searches a calibration pointer list: X[0]/X[1] give the flag mask and record
21761:                                 ;        stride, B = gear, A = pattern flag byte. It walks the bits to find the first matching entry and returns X
21762:                                 ;        = the pointer, with C=1 if there is no valid pointer.
21763:                                 ;   OBD1 LA444 (match 1.00 p1-exact): This routine jumps around in a pointer table
21764:                                 ;   with inputs:
21765:                                 ;   B - Gear
21766:                                 ;   A - Flag Byte (Actual inputs are L0037, L0038, L0039, L003A)
21767:                                 ;   called from: calc_TCC_apply_speed_DBC6, calc_TCC_release_request_E20A, calc_shift_speed_load_based_EAF1, calc_shift_speed_fixed_EB47, calc_shift_RPM_target_EB8E
21768:                                 ; ----------------------------------------------------------------------------
21769:     EBF2                        select_ptr_by_gear_flags_EBF2:
21770:     EBF2 37                             pshb                                ; EBF2  37            push B | OBD1: push gear
21771:     EBF3 36                             psha                                ; EBF3  36            push A | OBD1: 0 = Ai, 1 = Bi push flag
21772:     EBF4 A6 00                          ldaa $00,x                          ; EBF4  A6 00         A = [X+0] | OBD1: A = Xi[0]  get bit mask from calibration tables (usually $04)
21773:     EBF6 36                             psha                                ; EBF6  36            push A | OBD1: 0 = Xi[0], 1 = Ai, 2 = Bi
21774:     EBF7 A6 01                          ldaa $01,x                          ; EBF7  A6 01         A = [X+1] | OBD1: A = Xi[1] (usually $08)
21775:     EBF9 36                             psha                                ; EBF9  36            push A | OBD1: 0 = Xi[1], 1 = Xi[0], 2 = Ai, 3 = Bi
21776:     EBFA 58                             aslb                                ; EBFA  58            B <<= 1 | OBD1: double gear and offset it
21777:     EBFB 3A                             abx                                 ; EBFB  3A            X += B | OBD1: X = Xi + 2 * Bi
21778:     EBFC 86 01                          ldaa #$01                           ; EBFC  86 01         A = 1 | OBD1: A = 1  start with first bit...
21779:     EBFE 08                             inx                                 ; EBFE  08            X++
21780:     EBFF 08                             inx                                 ; EBFF  08            X++ | OBD1: X = Xi + 2 * Bi + 2
21781:     EC00 33                             pulb                                ; EC00  33            pop B | OBD1: B = Xi[1], 0 = Xi[0], 1 = Ai, 2 = Bi  get second bit mask value, what is it for? - maybe length of structure... looks right.
21782:     EC01                        loc_EC01:
21783:     EC01 3C                             pshx                                ; EC01  3C            push X | OBD1: 0:1 = (Xi + 2 * Bi + 2), 2 = Xi[0], 3 = Ai, 4 = Bi
21784:     EC02 30                             tsx                                 ; EC02  30            X = SP + 1
21785:     EC03 A5 03                          bita $03,x                          ; EC03  A5 03         test A mask [X+3] | OBD1: as soon as bit is found then skip out
21786:     EC05 26 0B                          bne loc_EC12                        ; EC05  26 0B         if any of mask [X+3] set goto loc_EC12 | OBD1: BR IF Ai & 1
21787:     EC07 A5 02                          bita $02,x                          ; EC07  A5 02         test A mask [X+2] | OBD1: Check compare with flag bit
21788:     EC09 26 0E                          bne loc_EC19                        ; EC09  26 0E         if any of mask [X+2] set goto loc_EC19 | OBD1: bit set? then get out
21789:     EC0B 48                             asla                                ; EC0B  48            A <<= 1 | OBD1: A <<= 1
21790:     EC0C 25 0B                          bcs loc_EC19                        ; EC0C  25 0B         if A < 0 goto loc_EC19 | OBD1: done bit list (8 bits?) then get out
21791:     EC0E 38                             pulx                                ; EC0E  38            pop X
21792:     EC0F 3A                             abx                                 ; EC0F  3A            X += B
21793:     EC10 20 EF                          bra loc_EC01                        ; EC10  20 EF         goto loc_EC01 | OBD1: go back.....
21794:     EC12                        loc_EC12:
21795:     EC12 38                             pulx                                ; EC12  38            pop X | OBD1: X = Pointer to Pointer, 0 = Xi[0], 1 = Ai, 2 = Bi
21796:     EC13 EE 00                          ldx $00,x                           ; EC13  EE 00         X = [X+0] | OBD1: fetch pointer and check if valid
21797:     EC15 27 03                          beq loc_EC1A                        ; EC15  27 03         if X == 0 goto loc_EC1A
21798:     EC17 20 04                          bra loc_EC1D                        ; EC17  20 04         goto loc_EC1D
21799:     EC19                        loc_EC19:
21800:     EC19 38                             pulx                                ; EC19  38            pop X
21801:     EC1A                        loc_EC1A:
21802:     EC1A 0D                             sec                                 ; EC1A  0D            C = 1 | OBD1: error flag - no pointer list found, skip function
21803:     EC1B 20 01                          bra loc_EC1E                        ; EC1B  20 01         goto loc_EC1E
21804:     EC1D                        loc_EC1D:
21805:     EC1D 0C                             clc                                 ; EC1D  0C            C = 0
21806:     EC1E                        loc_EC1E:
21807:     EC1E 31                             ins                                 ; EC1E  31            SP++ | OBD1: 0 = Ai, 1 = Bi
21808:     EC1F 32                             pula                                ; EC1F  32            pop A | OBD1: get flag back
21809:     EC20 33                             pulb                                ; EC20  33            pop B | OBD1: get gear back
21810:     EC21 39                             rts                                 ; EC21  39            return
