 7055:                                 ; STALL_TIMER_RESET
 7056:                                 ;   analysis [high]: Counts 25 ms ticks in 199A (saturates; reset elsewhere on reference pulses). At >= 13 ticks
 7057:                                 ;        (~325 ms) without a reference it declares a stall: FLAGS0.4 is set and all RPM variables are zeroed. Sets
 7058:                                 ;        1474 to RPM_RAW (or 1 when RPM is 0 and still cranking).
 7059:                                 ;   OBD1 STALL_TIMER_RESET (match 1.00 p1-exact): end of cruise control
 7060:                                 ;   called from: run_25ms_job
 7061:                                 ; ----------------------------------------------------------------------------
 7062:     8672                        STALL_TIMER_RESET:
 7063:     8672 7C 199A                        inc >stall_timer                    ; 8672  7C 19 9A      stall_timer++
 7064:     8675 26 03                          bne loc_867A                        ; 8675  26 03         if stall_timer != 0 goto loc_867A
 7065:     8677 7A 199A                        dec >stall_timer                    ; 8677  7A 19 9A      stall_timer--
 7066:     867A                        loc_867A:
 7067:     867A B6 199A                        ldaa >stall_timer                   ; 867A  B6 19 9A      A = stall_timer | 13 x 25 ms without reference = stalled: zero all RPM variables
