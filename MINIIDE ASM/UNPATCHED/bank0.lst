21826:     EC2F                        loc_EC2F:
21827:     EC2F 1A83 51EB                      cpd #$51EB                          ; EC2F  1A 83 51 EB   compare D with $51EB(20971)
21828:     EC33 23 03                          bls loc_EC38                        ; EC33  23 03         if D <= $51EB(20971) goto loc_EC38
21829:     EC35 CC 51EB                        ldd #$51EB                          ; EC35  CC 51 EB      D = $51EB(20971)
21830:     EC38                        loc_EC38:
21831:     EC38 CE 51EB                        ldx #DTC_P0602                      ; EC38  CE 51 EB      X = &DTC_P0602 | $51EB here is just a divisor constant, not the P0602 DTC record
21832:     EC3B 03                             fdiv                                ; EC3B  03            X = (D << 16) / X (fraction)
21833:     EC3C 8F                             xgdx                                ; EC3C  8F            swap D <-> X
21834:     EC3D CE 389E                        ldx #t17_altitude_weight_389E       ; EC3D  CE 38 9E      X = &t17_altitude_weight_389E
21835:     EC40 BD 66E5                        jsr >lookup_2D_17pt_noheader        ; EC40  BD 66 E5      A = 17pt lookup t17_altitude_weight_389E[A]
21836:     EC43 33                             pulb                                ; EC43  33            pop B
21837:     EC44 5D                             tstb                                ; EC44  5D            test B
21838:     EC45 2B 0B                          bmi loc_EC52                        ; EC45  2B 0B         if B < 0 (signed) goto loc_EC52
21839:     EC47 3D                             mul                                 ; EC47  3D            D = A * B
21840:     EC48 89 00                          adca #$00                           ; EC48  89 00         A += C + 0
21841:     EC4A 33                             pulb                                ; EC4A  33            pop B
21842:     EC4B 1B                             aba                                 ; EC4B  1B            A += B
21843:     EC4C 24 0E                          bcc loc_EC5C                        ; EC4C  24 0E         if A no overflow goto loc_EC5C
21844:     EC4E 86 FF                          ldaa #$FF                           ; EC4E  86 FF         A = $FF(255)
21845:     EC50 20 0A                          bra loc_EC5C                        ; EC50  20 0A         goto loc_EC5C
21846:     EC52                        loc_EC52:
21847:     EC52 50                             negb                                ; EC52  50            B = -B
21848:     EC53 3D                             mul                                 ; EC53  3D            D = A * B
21849:     EC54 89 00                          adca #$00                           ; EC54  89 00         A += C + 0
21850:     EC56 16                             tab                                 ; EC56  16            B = A
21851:     EC57 32                             pula                                ; EC57  32            pop A
21852:     EC58 10                             sba                                 ; EC58  10            A -= B
21853:     EC59 24 01                          bcc loc_EC5C                        ; EC59  24 01         if A >= 0 goto loc_EC5C
