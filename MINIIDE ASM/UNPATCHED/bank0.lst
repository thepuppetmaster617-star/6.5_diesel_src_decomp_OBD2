 6114:                                 ; TOC3_scheduler_ISR_8000
 6115:                                 ;   analysis [high]: TOC3 interrupt (reached via the common trampoline 7E99 in the vector table). Exact 160 Hz
 6116:                                 ;        with E=3.1457 MHz: adds 19661, or 19660 every 5th tick. Overrun watchdog, RAM-code hooks, then a rate-
 6117:                                 ;        divided dispatch: 160 Hz task, 12.5/25/50/100 ms jobs, then the 1 s job. Each job has a re-entrancy bit
 6118:                                 ;        (TASKFLAGS1) and an overrun bit ($56).
 6119:                                 ;   called from: far_run_1s_job_7E3F
 6120:                                 ; ----------------------------------------------------------------------------
 6121:     8000                        TOC3_scheduler_ISR_8000:
 6122:     8000 86 20                          ldaa #$20                           ; 8000  86 20         A = $20(32)
 6123:     8002 B7 1023                        staa >TFLG1                         ; 8002  B7 10 23      TFLG1 = A
 6124:     8005 13 56 7E 07                    brclr <task_overrun_flags,$7E,loc_8010; 8005  13 56 7E 07   if task_overrun_flags .1,.2,.3,.4,.5,.6 clear goto loc_8010 | a job overrun flag is set: count down; at 0 hang so the COP watchdog resets the ECM
 6125:     8009 7A 19A3                        dec >sched_overrun_count            ; 8009  7A 19 A3      sched_overrun_count--
