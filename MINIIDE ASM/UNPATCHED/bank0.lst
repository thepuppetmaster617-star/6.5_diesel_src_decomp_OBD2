 7361:                                 ; ----------------------------------------------------------------------------
 7362:                                 ; vss_period_from_pulse_count_886E
 7363:                                 ;   analysis [high]: Pulse-period calculator on the VSS struct (+0 last count, +1/2 last time, +3 timeout, +4/5
 7364:                                 ;        period, +6/7 new time, +8 new count). With new pulses, period = dTime/dPulses and the timeout is reloaded
 7365:                                 ;        from B. With no pulses, it counts the timeout down and returns FFFF (stopped) when it reaches 0. The
 7366:                                 ;        pulse delta is kept in $1CB1 for the odometer.
 7367:                                 ;   OBD1 L836A (match 0.98 p1-global): Looks like a math utility routine
 7368:                                 ;   called from: read_vehicle_speed
 7369:                                 ; ----------------------------------------------------------------------------
 7370:     886E                        vss_period_from_pulse_count_886E:
 7371:     886E 18A6 08                        ldaa $08,y                          ; 886E  18 A6 08      A = [Y+8]
 7372:     8871 18A0 00                        suba $00,y                          ; 8871  18 A0 00      A -= [Y+0]
 7373:     8874 B7 1CB1                        staa >VSS_pulse_delta               ; 8874  B7 1C B1      VSS_pulse_delta = A
 7374:     8877 26 13                          bne loc_888C                        ; 8877  26 13         if A != 0 goto loc_888C | no new pulses: count down the timeout; at 0 report period FFFF
 7375:     8879 18E6 03                        ldab $03,y                          ; 8879  18 E6 03      B = [Y+3]
 7376:     887C 27 06                          beq loc_8884                        ; 887C  27 06         if B == 0 goto loc_8884
 7377:     887E 5A                             decb                                ; 887E  5A            B--
 7378:     887F 18E7 03                        stab $03,y                          ; 887F  18 E7 03      [Y+3] = B
 7379:     8882 26 2B                          bne loc_88AF                        ; 8882  26 2B         if B != 0 goto loc_88AF
 7380:     8884                        loc_8884:
 7381:     8884 CC FFFF                        ldd #$FFFF                          ; 8884  CC FF FF      D = $FFFF(65535)
 7382:     8887 18ED 04                        std $04,y                           ; 8887  18 ED 04      [Y+4] = D
 7383:     888A 20 26                          bra loc_88B2                        ; 888A  20 26         goto loc_88B2
 7384:     888C                        loc_888C:
 7385:     888C 37                             pshb                                ; 888C  37            push B | new pulses: period = (t_new - t_last)/pulses, skipped on first edge after timeout
 7386:     888D 18E6 03                        ldab $03,y                          ; 888D  18 E6 03      B = [Y+3]
 7387:     8890 27 0D                          beq loc_889F                        ; 8890  27 0D         if B == 0 goto loc_889F
 7388:     8892 16                             tab                                 ; 8892  16            B = A
 7389:     8893 4F                             clra                                ; 8893  4F            A = 0
 7390:     8894 8F                             xgdx                                ; 8894  8F            swap D <-> X
 7391:     8895 18EC 06                        ldd $06,y                           ; 8895  18 EC 06      D = [Y+6]
 7392:     8898 18A3 01                        subd $01,y                          ; 8898  18 A3 01      D -= [Y+1]
 7393:     889B 02                             idiv                                ; 889B  02            X = D / X, D = remainder
 7394:     889C CDEF 04                        stx $04,y                           ; 889C  CD EF 04      [Y+4] = X
 7395:     889F                        loc_889F:
 7396:     889F CDEE 06                        ldx $06,y                           ; 889F  CD EE 06      X = [Y+6]
 7397:     88A2 CDEF 01                        stx $01,y                           ; 88A2  CD EF 01      [Y+1] = X
 7398:     88A5 18A6 08                        ldaa $08,y                          ; 88A5  18 A6 08      A = [Y+8]
 7399:     88A8 18A7 00                        staa $00,y                          ; 88A8  18 A7 00      [Y+0] = A
