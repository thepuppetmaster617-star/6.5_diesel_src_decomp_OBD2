 7174:     8735                        loc_8735:
 7175:     8735 97 4E                          staa <RAM_status_resistor           ; 8735  97 4E         RAM_status_resistor = A
 7176:     8737 FC 1C84                        ldd >IN_1802_sample0                ; 8737  FC 1C 84      D = IN_1802_sample0 | same 3-sample debounce for IOR 1802 switches -> IN_1802_debounced
 7177:     873A FD 1C85                        std >IN_1802_sample1                ; 873A  FD 1C 85      IN_1802_sample1 = D
 7178:     873D B6 1802                        ldaa >IOR_1802_AMUX                 ; 873D  B6 18 02      A = IOR_1802_AMUX
 7179:     8740 B7 1C84                        staa >IN_1802_sample0               ; 8740  B7 1C 84      IN_1802_sample0 = A
