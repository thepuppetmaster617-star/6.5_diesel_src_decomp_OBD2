  835:                                 ; ----------------------------------------------------------------------------
  836:                                 ; run_12ms_job
  837:                                 ;   analysis [medium]: 12.5 ms task. Before start/cranking (RPM hi < $50, battery >= $31, no TDC test) it drives
  838:                                 ;        the ITS toward the crank position from tbl2D_CRANK_INJ_TIMING_TBL_275B (ITS_ERROR = (target-pos)/2). Once
  839:                                 ;        the error stays at 0 for k_22AC ticks it sets $5A.1. Then it runs the injector-response/P0606 diag and
  840:                                 ;        the 360-deg delivery limiter, and calls the bank-1 12.5 ms jobs ($EE4C every other pass via $8F.0). I
  841:                                 ;   OBD1 _run_12ms_job (match 0.73 p2-dataref): MODULE START: INJECTION TIMING and WATCHDOG RESET
  842:                                 ;   Run every 12.5 ms
  843:                                 ;   called from: TOC3_scheduler_ISR_8000
  844:                                 ; ----------------------------------------------------------------------------
  845:     5E9D                        run_12ms_job:
  846:     5E9D 14 55 08                       bset <TASKFLAGS1,$08                ; 5E9D  14 55 08      TASKFLAGS1 .3 12.5 ms job running = 1
  847:     5EA0 B6 1986                        ldaa >engine_RPM                    ; 5EA0  B6 19 86      A = engine_RPM | pre-start only: engine not turning fast, not running, no TDC test, battery OK
  848:     5EA3 81 50                          cmpa #$50                           ; 5EA3  81 50         compare A with $50(80)
  849:     5EA5 24 67                          bcc loc_5F0E                        ; 5EA5  24 67         if engine_RPM >= $50(80) goto loc_5F0E
  850:     5EA7 12 5A 80 63                    brset <crank_ITS_flags,$80,loc_5F0E ; 5EA7  12 5A 80 63   if crank_ITS_flags .7 set goto loc_5F0E
