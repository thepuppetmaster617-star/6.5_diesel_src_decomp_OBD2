21723:                                 ; ----------------------------------------------------------------------------
21724:                                 ; FETCH_VAL_USING_PRNDL
21725:                                 ;   analysis [high]: If the PRNDL is in a manual range (L/2/3, Cal_bit_6_store b0-2) and the APP fault flag is
21726:                                 ;        clear, it indexes the pointer table X by ((range>>1)*k_3890 + gear B)*2 and returns that byte in A with
21727:                                 ;        C=0. Otherwise it returns A=0, C=1.
21728:                                 ;   OBD1 FETCH_VAL_USING_PRNDL (match 0.96 p1-global)
21729:                                 ;   called from: calc_shift_request_E4B2
21730:                                 ; ----------------------------------------------------------------------------
21731:     EBCF                        FETCH_VAL_USING_PRNDL:
21732:     EBCF 37                             pshb                                ; EBCF  37            push B
21733:     EBD0 12 88 04 1A                    brset <TRANS_FMEM_ENA_FLAGS,$04,loc_EBEE; EBD0  12 88 04 1A   if TRANS_FMEM_ENA_FLAGS .2 P1810 fault: force range = Drive 4 set goto loc_EBEE | OBD1: APP fault
21734:     EBD4 96 5F                          ldaa <Cal_bit_6_store               ; EBD4  96 5F         A = Cal_bit_6_store
21735:     EBD6 84 07                          anda #$07                           ; EBD6  84 07         A &= 7 (keep bits) | OBD1: check for 3-2-1 position... if in one of those then we run this; if not, skip.
21736:     EBD8 27 14                          beq loc_EBEE                        ; EBD8  27 14         if A == 0 goto loc_EBEE
21737:     EBDA 44                             lsra                                ; EBDA  44            A >>= 1
21738:     EBDB 37                             pshb                                ; EBDB  37            push B
21739:     EBDC F6 3890                        ldab >k_num_shift_adapt_tables_3890 ; EBDC  F6 38 90      B = k_num_shift_adapt_tables_3890
21740:     EBDF 3D                             mul                                 ; EBDF  3D            D = A * B
21741:     EBE0 32                             pula                                ; EBE0  32            pop A
21742:     EBE1 1B                             aba                                 ; EBE1  1B            A += B
21743:     EBE2 48                             asla                                ; EBE2  48            A <<= 1
21744:     EBE3 16                             tab                                 ; EBE3  16            B = A
21745:     EBE4 3A                             abx                                 ; EBE4  3A            X += B
21746:     EBE5 EE 00                          ldx $00,x                           ; EBE5  EE 00         X = [X+0]
21747:     EBE7 27 05                          beq loc_EBEE                        ; EBE7  27 05         if X == 0 goto loc_EBEE
21748:     EBE9 A6 00                          ldaa $00,x                          ; EBE9  A6 00         A = [X+0]
21749:     EBEB 0C                             clc                                 ; EBEB  0C            C = 0
21750:     EBEC 20 02                          bra loc_EBF0                        ; EBEC  20 02         goto loc_EBF0
21751:     EBEE                        loc_EBEE:
21752:     EBEE 4F                             clra                                ; EBEE  4F            A = 0 | OBD1: in OD position
21753:     EBEF 0D                             sec                                 ; EBEF  0D            C = 1
21754:     EBF0                        loc_EBF0:
21755:     EBF0 33                             pulb                                ; EBF0  33            pop B
21756:     EBF1 39                             rts                                 ; EBF1  39            return
