  597:                                 ; calc_ODM_status_hi_5CF7
  598:                                 ;   analysis [low]: Reads the ODM fault status over SPI (out_ODM_6D97 A=1, saved in $1BDA/$1BDB). For shift
  599:                                 ;        solenoid A and B it builds a 4-bit status (b0 commanded on, b1 off, b2/b3 ODM bit 4/5 fault flags) and
  600:                                 ;        runs it through sub_5E1E to update $1BB6 (sol A, used by diag_P0753) and $1BB7 (sol B). Then it runs a
  601:                                 ;        second state machine on $1BB9, gated by bits 0/1 of $1BBB and the ODM bit-6 flags.
  602:                                 ;   inferred [C, pass A]: writes ODM_status_hi, ODM_shiftA_diag_status, ODM_shiftB_diag_status,
