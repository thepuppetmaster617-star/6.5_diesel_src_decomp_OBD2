 7135:                                 ; ----------------------------------------------------------------------------
 7136:                                 ; debounce_discrete_inputs
 7137:                                 ;   analysis [high]: Three-sample debounce of IOR 1804 (brake/TCC brake/PTO/range switches) into
 7138:                                 ;        RAM_status_resistor and IOR 1802 (cruise/4WD/shift switches) into IN_1802_debounced. A bit takes its new
 7139:                                 ;        value only when the last three samples agree, otherwise it keeps the old value. With 200D.4 set, the
 7140:                                 ;        1804.0 PTO bit is masked from the samples, and old bit 0 stays set while [$0F].0 is clear.
 7141:                                 ;   OBD1 DEBOUNCE_SWITCHES (match 0.76 p2-dataref)
 7142:                                 ;   called from: run_25ms_job
 7143:                                 ; ----------------------------------------------------------------------------
 7144:     86F6                        debounce_discrete_inputs:
 7145:     86F6 FC 1C87                        ldd >IN_1804_sample0                ; 86F6  FC 1C 87      D = IN_1804_sample0 | shift sample history: s2<-s1<-s0, then read new 1804 sample
 7146:     86F9 FD 1C88                        std >IN_1804_sample1                ; 86F9  FD 1C 88      IN_1804_sample1 = D
 7147:     86FC B6 1804                        ldaa >IOR_1804                      ; 86FC  B6 18 04      A = IOR_1804
 7148:     86FF CE 200D                        ldx #Configuration_set_3_200D       ; 86FF  CE 20 0D      X = &Configuration_set_3_200D
 7149:     8702 1F 00 10 02                    brclr $00,x,$10,loc_8708            ; 8702  1F 00 10 02   if Configuration_set_3_200D .4 external module data tests clear goto loc_8708 | 200D.4: drop pin A6 (1804.0 PTO) from debounce
 7150:     8706 84 FE                          anda #$FE                           ; 8706  84 FE         A &= $FE(254) (keep bits)
 7151:     8708                        loc_8708:
 7152:     8708 B7 1C87                        staa >IN_1804_sample0               ; 8708  B7 1C 87      IN_1804_sample0 = A
 7153:     870B 16                             tab                                 ; 870B  16            B = A | changed = (s0^s1)|(s0^s2); stable bits take s0, changing bits keep the old debounced value
 7154:     870C B8 1C88                        eora >IN_1804_sample1               ; 870C  B8 1C 88      A ^= IN_1804_sample1
 7155:     870F 36                             psha                                ; 870F  36            push A
 7156:     8710 30                             tsx                                 ; 8710  30            X = SP + 1
 7157:     8711 F8 1C89                        eorb >IN_1804_sample2               ; 8711  F8 1C 89      B ^= IN_1804_sample2
 7158:     8714 EA 00                          orab $00,x                          ; 8714  EA 00         B |= [X+0]
 7159:     8716 17                             tba                                 ; 8716  17            A = B
 7160:     8717 53                             comb                                ; 8717  53            B = ~B
 7161:     8718 94 4E                          anda <RAM_status_resistor           ; 8718  94 4E         A &= RAM_status_resistor
 7162:     871A F4 1C87                        andb >IN_1804_sample0               ; 871A  F4 1C 87      B &= IN_1804_sample0
 7163:     871D E7 00                          stab $00,x                          ; 871D  E7 00         [X+0] = B
 7164:     871F AA 00                          oraa $00,x                          ; 871F  AA 00         A |= [X+0]
 7165:     8721 31                             ins                                 ; 8721  31            SP++
 7166:     8722 CE 200D                        ldx #Configuration_set_3_200D       ; 8722  CE 20 0D      X = &Configuration_set_3_200D | PTO bit 0 handling when 200D.4: keep it latched unless [$0F].0 says otherwise
 7167:     8725 1F 00 10 0C                    brclr $00,x,$10,loc_8735            ; 8725  1F 00 10 0C   if Configuration_set_3_200D .4 external module data tests clear goto loc_8735
 7168:     8729 0F                             sei                                 ; 8729  0F            disable interrupts
 7169:     872A 12 0F 01 06                    brset <$0F,$01,loc_8734             ; 872A  12 0F 01 06   if [$0F] .0 set goto loc_8734
 7170:     872E 13 4E 01 02                    brclr <RAM_status_resistor,$01,loc_8734; 872E  13 4E 01 02   if RAM_status_resistor .0 PTO request (OBD1: engine crank) clear goto loc_8734
 7171:     8732 8A 01                          oraa #$01                           ; 8732  8A 01         A |= 1
