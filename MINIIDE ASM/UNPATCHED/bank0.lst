23608:                                 ; ----------------------------------------------------------------------------
23609:                                 ; DO_GLOWPLUG_CTL
23610:                                 ;   analysis [medium]: 10 Hz glow-plug state machine. GLOW_PLUG_STATE low nibble is the state, dispatched through
23611:                                 ;        d_FD0C. States: 0 = compute preglow (inline at F9B3), 1 = preglow (relay on), 2 = afterglow off-phase, 3
23612:                                 ;        = afterglow on-phase, 4 = done, 5 = stalled/waiting for crank, 6 = low battery, 7 = battery
23613:                                 ;        dead/powerdown. Battery >= k_307A (16 V) forces state 4. States > 7 turn the relay off. The state-0 code
23614:                                 ;        (F9B3-F
23615:                                 ;   OBD1 DO_GLOWPLUG_CTL (match 1.00 p1-exact): Crazy complicated glow plug logic (with tons of code duplication)
23616:                                 ;   100ms - 10hz
23617:                                 ;   called from: run_100ms_engine_tasks_EC95
23618:                                 ; ----------------------------------------------------------------------------
23619:     F974                        DO_GLOWPLUG_CTL:
23620:     F974 B6 181E                        ldaa >GLOW_TIMER_2                  ; F974  B6 18 1E      A = GLOW_TIMER_2
23621:     F977 27 04                          beq loc_F97D                        ; F977  27 04         if A == 0 goto loc_F97D | OBD1: BR IF GLOW_TIMER_2 == 0
23622:     F979 4A                             deca                                ; F979  4A            A-- | OBD1: Else dec and Save
23623:     F97A B7 181E                        staa >GLOW_TIMER_2                  ; F97A  B7 18 1E      GLOW_TIMER_2 = A
23624:     F97D                        loc_F97D:
23625:     F97D B6 1921                        ldaa >battery_voltage               ; F97D  B6 19 21      A = battery_voltage
23626:     F980 B1 307A                        cmpa >k_glow_overvolt_cutoff_307A   ; F980  B1 30 7A      compare A with k_glow_overvolt_cutoff_307A | OBD1: 16 volts
23627:     F983 25 13                          bcs loc_F998                        ; F983  25 13         if battery_voltage < k_glow_overvolt_cutoff_307A goto loc_F998 | OBD1: BR IF BAT_VOLTS <= 16
23628:     F985 B6 1812                        ldaa >GLOW_PLUG_STATE               ; F985  B6 18 12      A = GLOW_PLUG_STATE
23629:     F988 16                             tab                                 ; F988  16            B = A
23630:     F989 84 0F                          anda #$0F                           ; F989  84 0F         A &= $0F(15) (keep bits)
23631:     F98B 81 07                          cmpa #$07                           ; F98B  81 07         compare A with 7
23632:     F98D 27 09                          beq loc_F998                        ; F98D  27 09         if A == 7 goto loc_F998 | OBD1: BR IF state == 7
23633:     F98F 17                             tba                                 ; F98F  17            A = B
23634:     F990 C6 04                          ldab #$04                           ; F990  C6 04         B = 4
23635:     F992 84 F0                          anda #$F0                           ; F992  84 F0         A &= $F0(240) (keep bits)
23636:     F994 1B                             aba                                 ; F994  1B            A += B | OBD1: Set State == 4
23637:     F995 B7 1812                        staa >GLOW_PLUG_STATE               ; F995  B7 18 12      GLOW_PLUG_STATE = A
23638:     F998                        loc_F998:
23639:     F998 F6 1812                        ldab >GLOW_PLUG_STATE               ; F998  F6 18 12      B = GLOW_PLUG_STATE
23640:     F99B C4 0F                          andb #$0F                           ; F99B  C4 0F         B &= $0F(15) (keep bits)
23641:     F99D C1 07                          cmpb #$07                           ; F99D  C1 07         compare B with 7
23642:     F99F 23 09                          bls loc_F9AA                        ; F99F  23 09         if B <= 7 goto loc_F9AA
23643:     F9A1 CE 1800                        ldx #IOR_1800                       ; F9A1  CE 18 00      X = &IOR_1800 | state > 7 is invalid: relay off
23644:     F9A4 1D 00 01                       bclr $00,x,$01                      ; F9A4  1D 00 01      IOR_1800 .0 glow plug relay = 0 | OBD1: turn off plugs
23645:     F9A7 7E FD0B                        jmp >loc_FD0B                       ; F9A7  7E FD 0B      goto loc_FD0B | OBD1: and out of here
