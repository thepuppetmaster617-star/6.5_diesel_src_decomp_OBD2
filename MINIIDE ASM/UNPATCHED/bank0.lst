 3302:                                 ; lookup_2D_table
 3303:                                 ;   analysis [high]: Standard 2D byte-table lookup (header = number of intervals). Falls through into
 3304:                                 ;        interp_2D_table.
 3305:                                 ;   OBD1 INTRP1_1 (match 1.00 p1-call)
 3306:                                 ;   called from: INIT_CRANK_FUEL_CTR, run_12ms_job, RESET_entry, calc_EGR_desired_vac_MAF_70DF, calc_injection_timing, idle_fuel_learn +26 more
