 1749:     6553 FC 100E                        ldd >TCNT                           ; 6553  FC 10 0E      D = TCNT | OBD1: grab TCNT
 1750:     6556 04                             lsrd                                ; 6556  04            D >>= 1
 1751:     6557 04                             lsrd                                ; 6557  04            D >>= 1
 1752:     6558 04                             lsrd                                ; 6558  04            D >>= 1
