18671:     D632                        loc_D632:
18672:     D632 B6 1B88                        ldaa >line_pressure_desired         ; D632  B6 1B 88      A = line_pressure_desired | pressure index = min(desired,$60)/3 with fraction in low byte for curve interpolation
18673:     D635 81 60                          cmpa #$60                           ; D635  81 60         compare A with $60(96)
18674:     D637 23 02                          bls loc_D63B                        ; D637  23 02         if line_pressure_desired <= $60(96) goto loc_D63B
18675:     D639 86 60                          ldaa #$60                           ; D639  86 60         A = $60(96)
18676:     D63B                        loc_D63B:
18677:     D63B 5F                             clrb                                ; D63B  5F            B = 0
18678:     D63C 04                             lsrd                                ; D63C  04            D >>= 1
18679:     D63D CE 0003                        ldx #$0003                          ; D63D  CE 00 03      X = $0003(3)
18680:     D640 02                             idiv                                ; D640  02            X = D / X, D = remainder
18681:     D641 5A                             decb                                ; D641  5A            B--
18682:     D642 2F 01                          ble loc_D645                        ; D642  2F 01         if B <= (signed) 0 goto loc_D645
18683:     D644 08                             inx                                 ; D644  08            X++
18684:     D645                        loc_D645:
18685:     D645 8F                             xgdx                                ; D645  8F            swap D <-> X
18686:     D646 F7 1AFA                        stab >pcs_v1AFA                     ; D646  F7 1A FA      pcs_v1AFA = B
