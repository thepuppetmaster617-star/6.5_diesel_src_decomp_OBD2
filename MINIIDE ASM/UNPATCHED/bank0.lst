 9583:                                 ; ----------------------------------------------------------------------------
 9584:                                 ; calc_tp_for_transmission
 9585:                                 ;   analysis [high]: Builds the simulated throttle position engine_load_est_filtered (OBD1 SIM_TPS) for trans
 9586:                                 ;        control. With cruise not engaged it is the filtered pedal. Otherwise it interpolates the cruise fuel
 9587:                                 ;        request through Fuel_demand_map_0..3 vs CRUISE_RPM_CAP, clamps it at k_2090 and lag-filters it with
 9588:                                 ;        k_2095. The OBD1 notes in the source describe the equations.
 9589:                                 ;   OBD1 calc_tp_for_transmission (match 1.00 p1-exact): This is used for other control stuff but not the actual
 9590:                                 ;        sync
 9591:                                 ;   fuel quantity calculation.
 9592:                                 ;   Equation inputs are:
 9593:                                 ;   CFR = CRUISE_FUEL_REQ_NO_DERATE
 9594:                                 ;   IFR = IDLE_FUEL_REQ
 9595:                                 ;   AFR = APP_FUEL_REQ
 9596:                                 ;   ACF  = A
 9597:                                 ;   called from: run_25ms_job
 9598:                                 ; ----------------------------------------------------------------------------
 9599:     9746                        calc_tp_for_transmission:
 9600:     9746 B6 19F0                        ldaa >CRUISE_STATE                  ; 9746  B6 19 F0      A = CRUISE_STATE
 9601:     9749 81 02                          cmpa #$02                           ; 9749  81 02         compare A with 2
 9602:     974B 22 06                          bhi loc_9753                        ; 974B  22 06         if CRUISE_STATE > 2 goto loc_9753 | OBD1: BR IF CRUISE_STATE > 2
 9603:     974D B6 1916                        ldaa >pedal_position_filtered       ; 974D  B6 19 16      A = pedal_position_filtered
 9604:     9750 7E 9827                        jmp >loc_9827                       ; 9750  7E 98 27      goto loc_9827 | OBD1: STORE SIM_TPS & rts
 9605:     9753                        loc_9753:
 9606:     9753 4F                             clra                                ; 9753  4F            A = 0
 9607:     9754 13 4C 40 0D                    brclr <ENGMODEFLAG,$40,loc_9765     ; 9754  13 4C 40 0D   if ENGMODEFLAG .6 idle mode clear goto loc_9765 | OBD1: in idle speed mode here
 9608:     9758 F6 1C7F                        ldab >IDLE_FUEL_REQ                 ; 9758  F6 1C 7F      B = IDLE_FUEL_REQ
 9609:     975B F1 19AB                        cmpb >APP_FUEL_REQ                  ; 975B  F1 19 AB      compare B with APP_FUEL_REQ
 9610:     975E 23 05                          bls loc_9765                        ; 975E  23 05         if IDLE_FUEL_REQ <= APP_FUEL_REQ goto loc_9765 | OBD1: BR IF IDLE_FUEL_REQ <= APP_FUEL_REQ
 9611:     9760 F1 1A15                        cmpb >CRUISE_FUEL_REQ               ; 9760  F1 1A 15      compare B with CRUISE_FUEL_REQ | OBD1: already capped for derate
 9612:     9763 22 39                          bhi loc_979E                        ; 9763  22 39         if IDLE_FUEL_REQ > CRUISE_FUEL_REQ goto loc_979E | OBD1: BR IF IDLE_FUEL_REQ > CRUISE_FUEL_REQ
 9613:     9765                        loc_9765:
 9614:     9765 B6 1916                        ldaa >pedal_position_filtered       ; 9765  B6 19 16      A = pedal_position_filtered
 9615:     9768 81 DF                          cmpa #$DF                           ; 9768  81 DF         compare A with $DF(223)
 9616:     976A 24 32                          bcc loc_979E                        ; 976A  24 32         if pedal_position_filtered >= $DF(223) goto loc_979E | OBD1: BR IF APP_COND > 0xDF (87%)
 9617:     976C F6 19AB                        ldab >APP_FUEL_REQ                  ; 976C  F6 19 AB      B = APP_FUEL_REQ
 9618:     976F F1 1A15                        cmpb >CRUISE_FUEL_REQ               ; 976F  F1 1A 15      compare B with CRUISE_FUEL_REQ
 9619:     9772 22 2A                          bhi loc_979E                        ; 9772  22 2A         if APP_FUEL_REQ > CRUISE_FUEL_REQ goto loc_979E | OBD1: BR IF APP_FUEL_REQ > CRUISE_FUEL_REQ
