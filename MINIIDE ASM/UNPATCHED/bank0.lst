 3326:                                 ; interp_row_idx_frac_6D0A
 3327:                                 ;   analysis [high]: Core interpolation: returns X[A]*(1-B/256) + X[A+1]*B/256. Fall-through target of
 3328:                                 ;        lookup_2D_table, also called directly by lookup_3D_table.
 3329:                                 ;   OBD1 LEE5A (match 1.00 p1-exact): 2D Interpolated Lookup
 3330:                                 ;   X = Row Pointer
 3331:                                 ;   A = Row Index
 3332:                                 ;   B = Coefficient
 3333:                                 ;   Returns A = *(X+A) * (1.0 - B) + *(X+A+1) * B
 3334:                                 ;   called from: lookup_3D_table
 3335:                                 ; ----------------------------------------------------------------------------
 3336:     6D0A                        interp_row_idx_frac_6D0A:
 3337:     6D0A 37                             pshb                                ; 6D0A  37            push B | OBD1: Save Low Byte
 3338:     6D0B 16                             tab                                 ; 6D0B  16            B = A | OBD1: B = High Byte
 3339:     6D0C 3A                             abx                                 ; 6D0C  3A            X += B | OBD1: X += B
 3340:     6D0D EC 00                          ldd $00,x                           ; 6D0D  EC 00         D = [X+0] | OBD1: Fetch bytes from table
 3341:     6D0F 10                             sba                                 ; 6D0F  10            A -= B | OBD1: Get difference
 3342:     6D10 33                             pulb                                ; 6D10  33            pop B
 3343:     6D11 24 06                          bcc loc_6D19                        ; 6D11  24 06         if A >= 0 goto loc_6D19
 3344:     6D13 40                             nega                                ; 6D13  40            A = -A
 3345:     6D14 3D                             mul                                 ; 6D14  3D            D = A * B
 3346:     6D15 A9 00                          adca $00,x                          ; 6D15  A9 00         A += C + [X+0]
 3347:     6D17 20 06                          bra loc_6D1F                        ; 6D17  20 06         goto loc_6D1F
 3348:     6D19                        loc_6D19:
 3349:     6D19 3D                             mul                                 ; 6D19  3D            D = A * B
 3350:     6D1A 89 00                          adca #$00                           ; 6D1A  89 00         A += C + 0
 3351:     6D1C A0 00                          suba $00,x                          ; 6D1C  A0 00         A -= [X+0]
 3352:     6D1E 40                             nega                                ; 6D1E  40            A = -A
 3353:     6D1F                        loc_6D1F:
 3354:     6D1F 39                             rts                                 ; 6D1F  39            return
