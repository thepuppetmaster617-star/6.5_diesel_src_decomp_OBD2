  138:                                 ; INIT_CRANK_FUEL_CTR
  139:                                 ;   analysis [high]: Clears the crank flags in $5A, STARTUP_CTR and the ITS settle counter $19C7, then sets $5A.0.
  140:                                 ;        Looks up the crank ITS timing position from tbl2D_CRANK_INJ_TIMING_TBL_275B vs coolant_temp into
  141:                                 ;        ITS_Cold_Base. If ITS_TIMING_POSITION >= CAL_ITS_RESET_INIT_LIMIT it is reset to that crank position.
  142:                                 ;   OBD1 INIT_CRANK_FUEL_CTR (match 1.00 p1-exact)
  143:                                 ;   called from: RESET_entry, ignition_off_powerdown_F615
  144:                                 ; ----------------------------------------------------------------------------
  145:     59B9                        INIT_CRANK_FUEL_CTR:
  146:     59B9 7F 005A                        clr >crank_ITS_flags                ; 59B9  7F 00 5A      crank_ITS_flags = 0
  147:     59BC 7F 19E3                        clr >STARTUP_CTR                    ; 59BC  7F 19 E3      STARTUP_CTR = 0
  148:     59BF 7F 19C7                        clr >ITS_settle_ctr                 ; 59BF  7F 19 C7      ITS_settle_ctr = 0
  149:     59C2 14 5A 01                       bset <crank_ITS_flags,$01           ; 59C2  14 5A 01      crank_ITS_flags .0 = 1
  150:     59C5 B6 1929                        ldaa >coolant_temp                  ; 59C5  B6 19 29      A = coolant_temp
  151:     59C8 CE 275B                        ldx #tbl2D_CRANK_INJ_TIMING_TBL_275B; 59C8  CE 27 5B      X = &tbl2D_CRANK_INJ_TIMING_TBL_275B | OBD1: c3...8c
  152:     59CB BD 6D06                        jsr >lookup_2D_table                ; 59CB  BD 6D 06      A = 2D lookup tbl2D_CRANK_INJ_TIMING_TBL_275B[A]
  153:     59CE B7 19C6                        staa >ITS_Cold_Base                 ; 59CE  B7 19 C6      ITS_Cold_Base = A
  154:     59D1 F6 0119                        ldab >ITS_TIMING_POSITION           ; 59D1  F6 01 19      B = ITS_TIMING_POSITION
  155:     59D4 F1 22AD                        cmpb >CAL_ITS_RESET_INIT_LIMIT      ; 59D4  F1 22 AD      compare B with CAL_ITS_RESET_INIT_LIMIT | ITS above limit after reset -> snap position to crank timing target
  156:     59D7 25 03                          bcs loc_59DC                        ; 59D7  25 03         if ITS_TIMING_POSITION < CAL_ITS_RESET_INIT_LIMIT goto loc_59DC
  157:     59D9 B7 0119                        staa >ITS_TIMING_POSITION           ; 59D9  B7 01 19      ITS_TIMING_POSITION = A
  158:     59DC                        loc_59DC:
  159:     59DC 39                             rts                                 ; 59DC  39            return
