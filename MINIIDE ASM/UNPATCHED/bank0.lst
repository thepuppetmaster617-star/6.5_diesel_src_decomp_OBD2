21924:     ECA3 B6 1AAE                        ldaa >sched_100ms_count             ; ECA3  B6 1A AE      A = sched_100ms_count
21925:     ECA6 81 05                          cmpa #$05                           ; ECA6  81 05         compare A with 5
21926:     ECA8 27 07                          beq loc_ECB1                        ; ECA8  27 07         if sched_100ms_count == 5 goto loc_ECB1
21927:     ECAA 81 0A                          cmpa #$0A                           ; ECAA  81 0A         compare A with $0A(10)
