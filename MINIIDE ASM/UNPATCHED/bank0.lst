  749:                                 ; sub_5E1E
  750:                                 ;   analysis [low]: Fault-latch state machine for one shift solenoid. A = previous state, B = status (b0 cmd on,
  751:                                 ;        b1 cmd off, b2/b3 driver fault flags). Fault seen in both commanded states sets b3/b4 and then b1 (fault)
  752:                                 ;        and clears b0; no fault sets b2 (pass). Returns the new state in A.
  753:                                 ;   called from: calc_ODM_status_hi_5CF7
  754:                                 ; ----------------------------------------------------------------------------
  755:     5E1E                        sub_5E1E:
  756:     5E1E 85 01                          bita #$01                           ; 5E1E  85 01         test A mask 1
  757:     5E20 27 2C                          beq loc_5E4E                        ; 5E20  27 2C         if mask 1 all clear goto loc_5E4E
  758:     5E22 C5 02                          bitb #$02                           ; 5E22  C5 02         test B mask 2
  759:     5E24 27 08                          beq loc_5E2E                        ; 5E24  27 08         if mask 2 all clear goto loc_5E2E
  760:     5E26 C5 08                          bitb #$08                           ; 5E26  C5 08         test B mask 8
  761:     5E28 26 0E                          bne loc_5E38                        ; 5E28  26 0E         if any of mask 8 set goto loc_5E38
