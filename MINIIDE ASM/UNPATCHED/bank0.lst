 7090:                                 ; calc_APP_fault_fuel_limit_86AB
 7091:                                 ;   analysis [medium]: OBD1 L81E7: in pedal-fault limp mode (DERATE_LIMP_ENA_FLAGS2.3) it ramps
 7092:                                 ;        APP_FAULT_PWR_LIMIT. It steps fuel_quantity by k_22B8 up while vehicle accel is below the speed-band
 7093:                                 ;        threshold (kw_22B2/4/6 by VSS < k_22B0/k_22B1), and down otherwise. In the low band the floor is k_22B9.
 7094:                                 ;   OBD1 L81E7 (match 1.00 p1-exact)
 7095:                                 ;   called from: run_25ms_job
 7096:                                 ; ----------------------------------------------------------------------------
 7097:     86AB                        calc_APP_fault_fuel_limit_86AB:
 7098:     86AB 13 53 08 46                    brclr <DERATE_LIMP_ENA_FLAGS2,$08,loc_86F5; 86AB  13 53 08 46   if DERATE_LIMP_ENA_FLAGS2 .3 only one valid pedal sensor (P1125) clear goto loc_86F5
 7099:     86AF B6 19F1                        ldaa >vehicle_speed                 ; 86AF  B6 19 F1      A = vehicle_speed | pick accel threshold by speed band: VSS<k_22B0 -> kw_22B2, <k_22B1 -> kw_22B4, else kw_22B6
 7100:     86B2 FE 22B2                        ldx >kw_22B2                        ; 86B2  FE 22 B2      X = kw_22B2
