 7253:                                 ; ----------------------------------------------------------------------------
 7254:                                 ; calculate_std_transmission_gear
 7255:                                 ;   analysis [medium]: Manual-trans gear estimate: ratio = engine_speed_filtered / TRANS_OUTPUT_SPEED as 8.8 fixed
 7256:                                 ;        point (FFFF if OSS=0 or ratio>=256). Ratio bands (kw_33DD..33E7) with hysteresis bands give gear 3..0
 7257:                                 ;        (low ratio = high gear). The result goes to gear_calc_MT and trans_gear_AT only when a brake-switch bit
 7258:                                 ;        (RAM_status_resistor b1|b2) is set; TRANSMISSION_RATIO is updated when the gear is accepted or held.
 7259:                                 ;   OBD1 calculate_std_transmission_gear (match 0.99 p1-global)
 7260:                                 ;   called from: run_25ms_job
 7261:                                 ; ----------------------------------------------------------------------------
 7262:     87D1                        calculate_std_transmission_gear:
 7263:     87D1 FE 18B9                        ldx >TRANS_OUTPUT_SPEED             ; 87D1  FE 18 B9      X = TRANS_OUTPUT_SPEED | ratio = engine_speed/OSS in 8.8 fixed point via idiv+fdiv; FFFF if OSS=0 or ratio >= 256
 7264:     87D4 27 16                          beq loc_87EC                        ; 87D4  27 16         if X == 0 goto loc_87EC
 7265:     87D6 3C                             pshx                                ; 87D6  3C            push X
 7266:     87D7 1838                           puly                                ; 87D7  18 38         pop Y
 7267:     87D9 FC 18C7                        ldd >engine_speed_filtered          ; 87D9  FC 18 C7      D = engine_speed_filtered
 7268:     87DC 02                             idiv                                ; 87DC  02            X = D / X, D = remainder
 7269:     87DD 3C                             pshx                                ; 87DD  3C            push X
 7270:     87DE 183C                           pshy                                ; 87DE  18 3C         push Y
 7271:     87E0 38                             pulx                                ; 87E0  38            pop X
 7272:     87E1 03                             fdiv                                ; 87E1  03            X = (D << 16) / X (fraction)
 7273:     87E2 8F                             xgdx                                ; 87E2  8F            swap D <-> X
 7274:     87E3 16                             tab                                 ; 87E3  16            B = A
 7275:     87E4 32                             pula                                ; 87E4  32            pop A
 7276:     87E5 4D                             tsta                                ; 87E5  4D            test A
 7277:     87E6 26 03                          bne loc_87EB                        ; 87E6  26 03         if A != 0 goto loc_87EB
 7278:     87E8 32                             pula                                ; 87E8  32            pop A
 7279:     87E9 20 04                          bra loc_87EF                        ; 87E9  20 04         goto loc_87EF
 7280:     87EB                        loc_87EB:
 7281:     87EB 31                             ins                                 ; 87EB  31            SP++
 7282:     87EC                        loc_87EC:
 7283:     87EC CC FFFF                        ldd #$FFFF                          ; 87EC  CC FF FF      D = $FFFF(65535)
 7284:     87EF                        loc_87EF:
 7285:     87EF 8F                             xgdx                                ; 87EF  8F            swap D <-> X | bands: <0.73 ->3, 0.95-1.05 ->2, 1.25-3.0 ->1, >=3.0 ->0; gaps between are hysteresis (keep gear)
 7286:     87F0 86 03                          ldaa #$03                           ; 87F0  86 03         A = 3
 7287:     87F2 BC 33DD                        cpx >kw_MT_ratio_g3_max_33DD        ; 87F2  BC 33 DD      compare X with kw_MT_ratio_g3_max_33DD
 7288:     87F5 25 29                          bcs loc_8820                        ; 87F5  25 29         if X < kw_MT_ratio_g3_max_33DD goto loc_8820
 7289:     87F7 BC 33DF                        cpx >kw_33DF                        ; 87F7  BC 33 DF      compare X with kw_33DF
 7290:     87FA 25 19                          bcs loc_8815                        ; 87FA  25 19         if X < kw_33DF goto loc_8815
