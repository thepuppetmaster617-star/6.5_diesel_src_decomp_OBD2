21532:     EAD7 37                             pshb                                ; EAD7  37            push B
21533:     EAD8 3D                             mul                                 ; EAD8  3D            D = A * B | A*3: high byte = cell index 0..2, low byte = interpolation fraction
21534:     EAD9 37                             pshb                                ; EAD9  37            push B
21535:     EADA 16                             tab                                 ; EADA  16            B = A
21536:     EADB 3A                             abx                                 ; EADB  3A            X += B
