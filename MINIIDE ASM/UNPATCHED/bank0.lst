 3356:                                 ; ----------------------------------------------------------------------------
 3357:                                 ; lookup_3D_table
 3358:                                 ;   analysis [high]: Header-driven 3D table: cols=(hdr&F)+2, rows=(hdr>>4)+2. Interpolates two adjacent rows by
 3359:                                 ;        column, then between them by row. Result in A.
 3360:                                 ;   OBD1 LKUP_3D (match 1.00 p1-exact): 3D table lookup, result in A
 3361:                                 ;   A - Column Coefficient
 3362:                                 ;   B - Row Coefficient
 3363:                                 ;   X - Table Address (Points to 1 byte table header)
 3364:                                 ;   Low nibble of table header is col count - 2
 3365:                                 ;   High nibble of table hea
 3366:                                 ;   called from: calc_EGR_desired_vac_MAF_70DF, calc_injection_timing, calc_fuel_timing_modifiers, glow_state0_init_F9B3, glow_state1_preglow_FA6F, boost_control +6 more
 3367:                                 ; ----------------------------------------------------------------------------
 3368:     6D20                        lookup_3D_table:
 3369:     6D20 3C                             pshx                                ; 6D20  3C            push X | OBD1: 7,8 - Table Header Address
 3370:     6D21 36                             psha                                ; 6D21  36            push A | OBD1: 6 - Col Coefficient
 3371:     6D22 37                             pshb                                ; 6D22  37            push B | OBD1: 5 - Row Coefficient
 3372:     6D23 3C                             pshx                                ; 6D23  3C            push X | OBD1: 3,4 - Table Header Address
 3373:     6D24 3C                             pshx                                ; 6D24  3C            push X | OBD1: 1,2 - Table Header Address
 3374:     6D25 34                             des                                 ; 6D25  34            SP--
 3375:     6D26 A6 00                          ldaa $00,x                          ; 6D26  A6 00         A = [X+0] | OBD1: Table Header (often 7f)
 3376:     6D28 16                             tab                                 ; 6D28  16            B = A | OBD1: copy to b
 3377:     6D29 30                             tsx                                 ; 6D29  30            X = SP + 1 | OBD1: X = SP
 3378:     6D2A C4 0F                          andb #$0F                           ; 6D2A  C4 0F         B &= $0F(15) (keep bits) | OBD1: Low nibble of table header
 3379:     6D2C 5C                             incb                                ; 6D2C  5C            B++
 3380:     6D2D 5C                             incb                                ; 6D2D  5C            B++
 3381:     6D2E E7 02                          stab $02,x                          ; 6D2E  E7 02         [X+2] = B | OBD1: *(X+2) = Col Count
 3382:     6D30 44                             lsra                                ; 6D30  44            A >>= 1
 3383:     6D31 44                             lsra                                ; 6D31  44            A >>= 1
 3384:     6D32 44                             lsra                                ; 6D32  44            A >>= 1
 3385:     6D33 44                             lsra                                ; 6D33  44            A >>= 1 | OBD1: high nibble of table header shifted to low nibble
 3386:     6D34 4C                             inca                                ; 6D34  4C            A++ | OBD1: A = Row Count - 1
 3387:     6D35 E6 05                          ldab $05,x                          ; 6D35  E6 05         B = [X+5] | OBD1: Original B input
 3388:     6D37 3D                             mul                                 ; 6D37  3D            D = A * B | OBD1: Times header high nibble
 3389:     6D38 E7 05                          stab $05,x                          ; 6D38  E7 05         [X+5] = B
 3390:     6D3A E6 02                          ldab $02,x                          ; 6D3A  E6 02         B = [X+2]
 3391:     6D3C 3D                             mul                                 ; 6D3C  3D            D = A * B
 3392:     6D3D E3 03                          addd $03,x                          ; 6D3D  E3 03         D += [X+3]
 3393:     6D3F ED 03                          std $03,x                           ; 6D3F  ED 03         [X+3] = D | OBD1: Pointer to first row
 3394:     6D41 E6 02                          ldab $02,x                          ; 6D41  E6 02         B = [X+2] | OBD1: Col Count
 3395:     6D43 5A                             decb                                ; 6D43  5A            B--
 3396:     6D44 A6 06                          ldaa $06,x                          ; 6D44  A6 06         A = [X+6] | OBD1: Col Coeff
 3397:     6D46 EE 03                          ldx $03,x                           ; 6D46  EE 03         X = [X+3] | OBD1: Pointer to first row
 3398:     6D48 8D BE                          bsr interp_2D_table                 ; 6D48  8D BE         call interp_2D_table | OBD1: First Row Lookup
 3399:     6D4A 30                             tsx                                 ; 6D4A  30            X = SP + 1
 3400:     6D4B A7 00                          staa $00,x                          ; 6D4B  A7 00         [X+0] = A | OBD1: *(X) = First Row Lookup Result
 3401:     6D4D A6 06                          ldaa $06,x                          ; 6D4D  A6 06         A = [X+6] | OBD1: Col Coeff
 3402:     6D4F E6 02                          ldab $02,x                          ; 6D4F  E6 02         B = [X+2] | OBD1: Col Cnt
 3403:     6D51 EE 03                          ldx $03,x                           ; 6D51  EE 03         X = [X+3] | OBD1: First Row
 3404:     6D53 3A                             abx                                 ; 6D53  3A            X += B | OBD1: Skip to second row by adding col count
 3405:     6D54 5A                             decb                                ; 6D54  5A            B--
 3406:     6D55 8D B1                          bsr interp_2D_table                 ; 6D55  8D B1         call interp_2D_table | OBD1: Second Row Lookup
 3407:     6D57 30                             tsx                                 ; 6D57  30            X = SP + 1
 3408:     6D58 A7 01                          staa $01,x                          ; 6D58  A7 01         [X+1] = A | OBD1: Second Result
 3409:     6D5A E6 05                          ldab $05,x                          ; 6D5A  E6 05         B = [X+5] | OBD1: Row Coefficient
 3410:     6D5C 4F                             clra                                ; 6D5C  4F            A = 0 | OBD1: No Col offset, X and X+1
 3411:     6D5D 8D AB                          bsr interp_row_idx_frac_6D0A        ; 6D5D  8D AB         call interp_row_idx_frac_6D0A | OBD1: Interpolate intermediate results
 3412:     6D5F 38                             pulx                                ; 6D5F  38            pop X
