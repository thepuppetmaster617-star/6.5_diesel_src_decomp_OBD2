 7326:                                 ; ----------------------------------------------------------------------------
 7327:                                 ; read_vehicle_speed
 7328:                                 ;   analysis [high]: Samples the VSS pulse accumulator count and timestamp atomically into VEH_SPD_INPUT_STRUCT
 7329:                                 ;        and gets the pulse period from read_vehicle_speed_part_886E (timeout reload k_3405=7). Speed =
 7330:                                 ;        $0565(1381)*65536/period, filtered with CAL_VEH_SPEED3_FILT into vehicle_speed; it is 0 when the period
 7331:                                 ;        times out (FFFF).
 7332:                                 ;   OBD1 read_vehicle_speed (match 1.00 p1-exact)
 7333:                                 ;   called from: run_25ms_job
 7334:                                 ; ----------------------------------------------------------------------------
 7335:     8837                        read_vehicle_speed:
 7336:     8837 0F                             sei                                 ; 8837  0F            disable interrupts
 7337:     8838 F6 1CAD                        ldab >VEH_SPD_4K_PAICT              ; 8838  F6 1C AD      B = VEH_SPD_4K_PAICT | OBD1: PAI counts
 7338:     883B FE 1CAE                        ldx >VEH_SPD_4K_CT                  ; 883B  FE 1C AE      X = VEH_SPD_4K_CT
 7339:     883E 0E                             cli                                 ; 883E  0E            enable interrupts
 7340:     883F 18CE 1CA4                      ldy #VEH_SPD_INPUT_STRUCT           ; 883F  18 CE 1C A4   Y = &VEH_SPD_INPUT_STRUCT
 7341:     8843 18E7 08                        stab $08,y                          ; 8843  18 E7 08      VEH_SPD_INPUT_STRUCT+8 = B
 7342:     8846 CDEF 06                        stx $06,y                           ; 8846  CD EF 06      VEH_SPD_INPUT_STRUCT+6 = X
 7343:     8849 F6 3405                        ldab >k_VSS_timeout_passes_3405     ; 8849  F6 34 05      B = k_VSS_timeout_passes_3405 | OBD1: is set to 7
 7344:     884C BD 886E                        jsr >vss_period_from_pulse_count_886E; 884C  BD 88 6E      call vss_period_from_pulse_count_886E
 7345:     884F 1A83 FFFF                      cpd #$FFFF                          ; 884F  1A 83 FF FF   compare D with $FFFF(65535) | FFFF period = no pulses within timeout -> speed 0
 7346:     8853 26 05                          bne loc_885A                        ; 8853  26 05         if D != $FFFF(65535) goto loc_885A
 7347:     8855 CC 0000                        ldd #$0000                          ; 8855  CC 00 00      D = $0000(0)
 7348:     8858 20 10                          bra loc_886A                        ; 8858  20 10         goto loc_886A
 7349:     885A                        loc_885A:
 7350:     885A CE 0565                        ldx #$0565                          ; 885A  CE 05 65      X = $0565(1381) | speed = 1381*65536/period (1381 = pulses-per-mile scaling) | OBD1: pulses per mile
 7351:     885D 8F                             xgdx                                ; 885D  8F            swap D <-> X
 7352:     885E 03                             fdiv                                ; 885E  03            X = (D << 16) / X (fraction)
 7353:     885F 8F                             xgdx                                ; 885F  8F            swap D <-> X
 7354:     8860 FE 19F1                        ldx >vehicle_speed                  ; 8860  FE 19 F1      X = vehicle_speed
 7355:     8863 18CE 2092                      ldy #CAL_VEH_SPEED3_FILT            ; 8863  18 CE 20 92   Y = &CAL_VEH_SPEED3_FILT
 7356:     8867 BD 6685                        jsr >Sensor_smoothing_SPEED         ; 8867  BD 66 85      call Sensor_smoothing_SPEED
 7357:     886A                        loc_886A:
 7358:     886A FD 19F1                        std >vehicle_speed                  ; 886A  FD 19 F1      vehicle_speed = D
