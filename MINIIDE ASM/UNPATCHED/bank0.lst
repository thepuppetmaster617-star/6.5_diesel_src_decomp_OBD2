  852:     5EAF B6 1921                        ldaa >battery_voltage               ; 5EAF  B6 19 21      A = battery_voltage
  853:     5EB2 81 31                          cmpa #$31                           ; 5EB2  81 31         compare A with $31(49)
  854:     5EB4 25 58                          bcs loc_5F0E                        ; 5EB4  25 58         if battery_voltage < $31(49) goto loc_5F0E
  855:     5EB6 12 5A 08 1D                    brset <crank_ITS_flags,$08,loc_5ED7 ; 5EB6  12 5A 08 1D   if crank_ITS_flags .3 set goto loc_5ED7
