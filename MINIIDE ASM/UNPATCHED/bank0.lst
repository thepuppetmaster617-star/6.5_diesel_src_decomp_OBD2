21895:     EC85 4F                             clra                                ; EC85  4F            A = 0
21896:     EC86 5F                             clrb                                ; EC86  5F            B = 0
21897:     EC87 20 09                          bra loc_EC92                        ; EC87  20 09         goto loc_EC92
