 3414:     6D61 38                             pulx                                ; 6D61  38            pop X
 3415:     6D62 31                             ins                                 ; 6D62  31            SP++
 3416:     6D63 38                             pulx                                ; 6D63  38            pop X | OBD1: Restore stack, result in A
 3417:     6D64 39                             rts                                 ; 6D64  39            return
