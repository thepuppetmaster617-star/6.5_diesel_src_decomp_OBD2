21813:                                 ; blend_by_altitude_EC22
21814:                                 ;   analysis [medium]: Not a DTC routine: '#DTC_P0602' is really the constant $51EB used as an fdiv divisor.
21815:                                 ;        Weight = t17_389E[(18DE-$4000)/$51EB], where 18DE is a baro-derived value from B4BF. Returns A = A +
21816:                                 ;        B*weight, with B a signed delta, clamped 0..255.
21817:                                 ;   called from: calc_TCC_apply_speed_DBC6, calc_TCC_release_request_E20A, calc_shift_speed_load_based_EAF1, calc_shift_speed_fixed_EB47, calc_shift_RPM_target_EB8E
21818:                                 ; ----------------------------------------------------------------------------
21819:     EC22                        blend_by_altitude_EC22:
21820:     EC22 36                             psha                                ; EC22  36            push A
21821:     EC23 37                             pshb                                ; EC23  37            push B
21822:     EC24 FC 18DE                        ldd >altitude_factor                ; EC24  FC 18 DE      D = altitude_factor | 18DE = baro-derived altitude value (B4BF); weight = t17_389E[(18DE-$4000)/$51EB]
21823:     EC27 83 4000                        subd #$4000                         ; EC27  83 40 00      D -= $4000(16384)
21824:     EC2A 24 03                          bcc loc_EC2F                        ; EC2A  24 03         if D >= 0 goto loc_EC2F
