 7181:     8744 B8 1C85                        eora >IN_1802_sample1               ; 8744  B8 1C 85      A ^= IN_1802_sample1
 7182:     8747 36                             psha                                ; 8747  36            push A
 7183:     8748 30                             tsx                                 ; 8748  30            X = SP + 1
 7184:     8749 F8 1C86                        eorb >IN_1802_sample2               ; 8749  F8 1C 86      B ^= IN_1802_sample2
 7185:     874C EA 00                          orab $00,x                          ; 874C  EA 00         B |= [X+0]
 7186:     874E 17                             tba                                 ; 874E  17            A = B
 7187:     874F 53                             comb                                ; 874F  53            B = ~B
 7188:     8750 94 4F                          anda <IN_1802_debounced             ; 8750  94 4F         A &= IN_1802_debounced
 7189:     8752 F4 1C84                        andb >IN_1802_sample0               ; 8752  F4 1C 84      B &= IN_1802_sample0
