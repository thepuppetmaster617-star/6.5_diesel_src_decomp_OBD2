 1717:                                 ; TOVFL_SERVICE
 1718:                                 ;   analysis [high]: Timer-overflow ISR: counts TOVFL_CNT (saturating) and TCNT_EXTENSION, and adds 16 to the high
 1719:                                 ;        bytes of the trans input shaft and 4K VSS 20-bit timestamp extensions (TCNT is used >>4).
 1720:                                 ;   OBD1 TOVFL_SERVICE (match 1.00 p1-exact): TOVFL flag interrupt
 1721:                                 ; ----------------------------------------------------------------------------
 1722:     652A                        TOVFL_SERVICE:
 1723:     652A B6 198B                        ldaa >TOVFL_CNT                     ; 652A  B6 19 8B      A = TOVFL_CNT | OBD1: increment TOVFL 1 count
 1724:     652D 4C                             inca                                ; 652D  4C            A++
 1725:     652E 27 03                          beq loc_6533                        ; 652E  27 03         if A == 0 goto loc_6533
 1726:     6530 B7 198B                        staa >TOVFL_CNT                     ; 6530  B7 19 8B      TOVFL_CNT = A
 1727:     6533                        loc_6533:
 1728:     6533 B6 19D4                        ldaa >TCNT_EXTENSION                ; 6533  B6 19 D4      A = TCNT_EXTENSION | OBD1: increment rolling timer overflow counter
 1729:     6536 4C                             inca                                ; 6536  4C            A++
 1730:     6537 B7 19D4                        staa >TCNT_EXTENSION                ; 6537  B7 19 D4      TCNT_EXTENSION = A
 1731:     653A B6 1C99                        ldaa >TRANS_SHAFT_CTR_EXTENSION     ; 653A  B6 1C 99      A = TRANS_SHAFT_CTR_EXTENSION | OBD1: add 16 to this counter
 1732:     653D 8B 10                          adda #$10                           ; 653D  8B 10         A += $10(16)
 1733:     653F B7 1C99                        staa >TRANS_SHAFT_CTR_EXTENSION     ; 653F  B7 1C 99      TRANS_SHAFT_CTR_EXTENSION = A
 1734:     6542 B6 1CB0                        ldaa >VEH_SPD_4K_TCNT               ; 6542  B6 1C B0      A = VEH_SPD_4K_TCNT | OBD1: and add 16 to this counter too
 1735:     6545 8B 10                          adda #$10                           ; 6545  8B 10         A += $10(16)
 1736:     6547 B7 1CB0                        staa >VEH_SPD_4K_TCNT               ; 6547  B7 1C B0      VEH_SPD_4K_TCNT = A
 1737:     654A 86 80                          ldaa #$80                           ; 654A  86 80         A = $80(128)
 1738:     654C B7 1025                        staa >TFLG2                         ; 654C  B7 10 25      TFLG2 = A | OBD1: clear timer overflow flag
 1739:     654F 3B                             rti                                 ; 654F  3B            return from interrupt
