 7887:     8C3A BB 2312                        adda >CAL_DRAG_ADAPT_MAXRPMERR      ; 8C3A  BB 23 12      A += CAL_DRAG_ADAPT_MAXRPMERR
 7888:     8C3D B1 1986                        cmpa >engine_RPM                    ; 8C3D  B1 19 86      compare A with engine_RPM
