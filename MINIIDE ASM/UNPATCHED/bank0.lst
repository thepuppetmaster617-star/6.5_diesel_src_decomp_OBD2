21909:                                 ; ----------------------------------------------------------------------------
21910:                                 ; run_100ms_engine_tasks_EC95
21911:                                 ;   analysis [medium]: 100 ms engine housekeeping, called from bank-1 far_b1_part_8089. Decides running vs stopped
21912:                                 ;        (RPM > k_2259), counts ENGINE_RUN_TIME and resets fueling/antistall state when stopped. Captures startup
21913:                                 ;        ECT once. Calls glow-plug, sensor linearization, baro, APP zero, engine-stop solenoid, boost control,
21914:                                 ;        shift-pattern select, fuel/timing modifiers and backup timing. Also decays the cold-start timing adde
21915:                                 ;   called from: TOC3_scheduler_ISR_8000
21916:                                 ; ----------------------------------------------------------------------------
21917:     EC95                        run_100ms_engine_tasks_EC95:
21918:     EC95 14 55 20                       bset <TASKFLAGS1,$20                ; EC95  14 55 20      TASKFLAGS1 .5 100 ms job in progress = 1
21919:     EC98 B6 1F70                        ldaa >security_lockout_timer        ; EC98  B6 1F 70      A = security_lockout_timer | 1AAE counts 0..9 at 100 ms -> bulb-test timer service every 500 ms
21920:     EC9B 27 03                          beq loc_ECA0                        ; EC9B  27 03         if A == 0 goto loc_ECA0
21921:     EC9D 7A 1F70                        dec >security_lockout_timer         ; EC9D  7A 1F 70      security_lockout_timer--
21922:     ECA0                        loc_ECA0:
