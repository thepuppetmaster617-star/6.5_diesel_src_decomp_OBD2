  206:     5A00 18E6 00                        ldab $00,y                          ; 5A00  18 E6 00      B = [Y+0]
  207:     5A03                        loc_5A03:
  208:     5A03 3C                             pshx                                ; 5A03  3C            push X
  209:     5A04 3A                             abx                                 ; 5A04  3A            X += B
  210:     5A05 18A6 01                        ldaa $01,y                          ; 5A05  18 A6 01      A = [Y+1]
  211:     5A08 A7 00                          staa $00,x                          ; 5A08  A7 00         [X+0] = A
  212:     5A0A 1808                           iny                                 ; 5A0A  18 08         Y++
  213:     5A0C 1808                           iny                                 ; 5A0C  18 08         Y++
  214:     5A0E 38                             pulx                                ; 5A0E  38            pop X
  215:     5A0F 18E6 00                        ldab $00,y                          ; 5A0F  18 E6 00      B = [Y+0]
  216:     5A12 26 EF                          bne loc_5A03                        ; 5A12  26 EF         if B != 0 goto loc_5A03
  217:     5A14 39                             rts                                 ; 5A14  39            return
