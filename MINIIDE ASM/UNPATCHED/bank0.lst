14263:     B7F8 FC 1897                        ldd >engine_speed_raw_trans         ; B7F8  FC 18 97      D = engine_speed_raw_trans
14264:     B7FB B3 18A8                        subd >trans_v18A8                   ; B7FB  B3 18 A8      D -= trans_v18A8
14265:     B7FE 46                             rora                                ; B7FE  46            A rotate right thru C
14266:     B7FF 49                             rola                                ; B7FF  49            A rotate left thru C
14267:     B800 28 07                          bvc loc_B809                        ; B800  28 07         if no overflow goto loc_B809
