 7196:                                 ; ----------------------------------------------------------------------------
 7197:                                 ; calculate_st_trans_shaft_speeds
 7198:                                 ;   analysis [medium]: Filters raw engine speed $1897 into engine_speed_filtered and runs the OSS calculation.
 7199:                                 ;        When the trans sensors are wired to the ECM (200D.3), output speed raw = trans input speed * 1.9375.
 7200:                                 ;        Filters TRANS_OUTPUT_SPEED (CAL_OSS_FILTER), then computes RAW_VEHICLE_SPEED = OSS_raw /
 7201:                                 ;        CAL_VEH_GEAR_RATIO plus a signed trim [$1896], rounded and filtered into VEHICLE_SPEED_0.
 7202:                                 ;   OBD1 calculate_st_trans_shaft_speeds (match 0.84 p1-global): Transmission now...
 7203:                                 ;   called from: run_25ms_job
 7204:                                 ; ----------------------------------------------------------------------------
 7205:     875D                        calculate_st_trans_shaft_speeds:
 7206:     875D FC 1897                        ldd >engine_speed_raw_trans         ; 875D  FC 18 97      D = engine_speed_raw_trans | engine speed filter, coef tbl_3892 ($FC)
 7207:     8760 FE 18C7                        ldx >engine_speed_filtered          ; 8760  FE 18 C7      X = engine_speed_filtered
 7208:     8763 18CE 3892                      ldy #tbl_3892                       ; 8763  18 CE 38 92   Y = &tbl_3892
 7209:     8767 BD 6685                        jsr >Sensor_smoothing_SPEED         ; 8767  BD 66 85      call Sensor_smoothing_SPEED
 7210:     876A FD 18C7                        std >engine_speed_filtered          ; 876A  FD 18 C7      engine_speed_filtered = D
 7211:     876D BD 96C4                        jsr >CALC_OSS_SPEED                 ; 876D  BD 96 C4      call CALC_OSS_SPEED
 7212:     8770 CE 200D                        ldx #Configuration_set_3_200D       ; 8770  CE 20 0D      X = &Configuration_set_3_200D
 7213:     8773 1F 00 08 19                    brclr $00,x,$08,loc_8790            ; 8773  1F 00 08 19   if Configuration_set_3_200D .3 trans sensors wired to ECM clear goto loc_8790 | 200D.3: set = trans speed via 1877/18B7, clr = TIC2 input shaft 1C92/1C93
 7214:     8777 BD 9612                        jsr >calc_input_shaft_speed_raw_9612; 8777  BD 96 12      call calc_input_shaft_speed_raw_9612
 7215:     877A BD B6BE                        jsr >filter_trans_input_speed_B6BE  ; 877A  BD B6 BE      call filter_trans_input_speed_B6BE
 7216:     877D CE 18A4                        ldx #trans_input_speed_filtered     ; 877D  CE 18 A4      X = &trans_input_speed_filtered | OSS raw = input speed + input*240/256 (x1.9375 fixed ratio) when trans sensors go to ECM
 7217:     8780 86 F0                          ldaa #$F0                           ; 8780  86 F0         A = $F0(240)
 7218:     8782 BD 6774                        jsr >MUL8_16                        ; 8782  BD 67 74      call MUL8_16
 7219:     8785 F3 18A4                        addd >trans_input_speed_filtered    ; 8785  F3 18 A4      D += trans_input_speed_filtered
 7220:     8788 24 03                          bcc loc_878D                        ; 8788  24 03         if D no overflow goto loc_878D
 7221:     878A CC FFFF                        ldd #$FFFF                          ; 878A  CC FF FF      D = $FFFF(65535)
 7222:     878D                        loc_878D:
 7223:     878D FD 18B0                        std >TRANS_OUTPUT_SPEED_RAW         ; 878D  FD 18 B0      TRANS_OUTPUT_SPEED_RAW = D
 7224:     8790                        loc_8790:
 7225:     8790 FC 18B0                        ldd >TRANS_OUTPUT_SPEED_RAW         ; 8790  FC 18 B0      D = TRANS_OUTPUT_SPEED_RAW
 7226:     8793 FE 18B9                        ldx >TRANS_OUTPUT_SPEED             ; 8793  FE 18 B9      X = TRANS_OUTPUT_SPEED
 7227:     8796 18CE 3853                      ldy #CAL_OSS_FILTER                 ; 8796  18 CE 38 53   Y = &CAL_OSS_FILTER
 7228:     879A BD 6685                        jsr >Sensor_smoothing_SPEED         ; 879A  BD 66 85      call Sensor_smoothing_SPEED
 7229:     879D FD 18B9                        std >TRANS_OUTPUT_SPEED             ; 879D  FD 18 B9      TRANS_OUTPUT_SPEED = D
 7230:     87A0 FC 18B0                        ldd >TRANS_OUTPUT_SPEED_RAW         ; 87A0  FC 18 B0      D = TRANS_OUTPUT_SPEED_RAW | VSS = OSS_raw / CAL_VEH_GEAR_RATIO ($BA00), plus signed trim [$1896] on the high byte, saturating
 7231:     87A3 FE 3856                        ldx >CAL_VEH_GEAR_RATIO             ; 87A3  FE 38 56      X = CAL_VEH_GEAR_RATIO
 7232:     87A6 03                             fdiv                                ; 87A6  03            X = (D << 16) / X (fraction)
 7233:     87A7 8F                             xgdx                                ; 87A7  8F            swap D <-> X
 7234:     87A8 80 80                          suba #$80                           ; 87A8  80 80         A -= $80(128)
 7235:     87AA BB 1896                        adda >trans_v1896                   ; 87AA  BB 18 96      A += trans_v1896
 7236:     87AD 28 07                          bvc loc_87B6                        ; 87AD  28 07         if no overflow goto loc_87B6
 7237:     87AF CC 7FFF                        ldd #$7FFF                          ; 87AF  CC 7F FF      D = $7FFF(32767)
 7238:     87B2 C9 00                          adcb #$00                           ; 87B2  C9 00         B += C + 0
 7239:     87B4 89 00                          adca #$00                           ; 87B4  89 00         A += C + 0
 7240:     87B6                        loc_87B6:
 7241:     87B6 8B 80                          adda #$80                           ; 87B6  8B 80         A += $80(128)
 7242:     87B8 C3 0080                        addd #$0080                         ; 87B8  C3 00 80      D += $0080(128)
 7243:     87BB 24 03                          bcc loc_87C0                        ; 87BB  24 03         if D no overflow goto loc_87C0
 7244:     87BD CC FFFF                        ldd #$FFFF                          ; 87BD  CC FF FF      D = $FFFF(65535)
 7245:     87C0                        loc_87C0:
 7246:     87C0 FD 18C1                        std >RAW_VEHICLE_SPEED              ; 87C0  FD 18 C1      RAW_VEHICLE_SPEED = D
 7247:     87C3 FE 18BD                        ldx >VEHICLE_SPEED_0                ; 87C3  FE 18 BD      X = VEHICLE_SPEED_0
 7248:     87C6 18CE 3858                      ldy #CAL_TRANS_VSPD_FILT            ; 87C6  18 CE 38 58   Y = &CAL_TRANS_VSPD_FILT
 7249:     87CA BD 6685                        jsr >Sensor_smoothing_SPEED         ; 87CA  BD 66 85      call Sensor_smoothing_SPEED
 7250:     87CD FD 18BD                        std >VEHICLE_SPEED_0                ; 87CD  FD 18 BD      VEHICLE_SPEED_0 = D
 7251:     87D0 39                             rts                                 ; 87D0  39            return
