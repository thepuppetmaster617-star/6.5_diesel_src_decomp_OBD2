21859:                                 ; add_weighted_offset_16_EC5D
21860:                                 ;   analysis [medium]: OBD1 LA4C6. Takes the 16-bit base in X and the signed 16-bit offset in D. Scales the offset
21861:                                 ;        by factor 18DD/256 (MUL8_16), adds it to the base and clamps 0..$FFFF. Result in D.
21862:                                 ;   OBD1 LA4C6 (match 1.00 p1-exact)
21863:                                 ;   called from: calc_shift_speed_load_based_EAF1, calc_shift_speed_fixed_EB47, calc_shift_RPM_target_EB8E
21864:                                 ; ----------------------------------------------------------------------------
21865:     EC5D                        add_weighted_offset_16_EC5D:
21866:     EC5D 3C                             pshx                                ; EC5D  3C            push X
