21878:     EC6C BD 6774                        jsr >MUL8_16                        ; EC6C  BD 67 74      call MUL8_16
21879:     EC6F 38                             pulx                                ; EC6F  38            pop X
21880:     EC70 30                             tsx                                 ; EC70  30            X = SP + 1
21881:     EC71 6D 00                          tst $00,x                           ; EC71  6D 00         test [X+0]
21882:     EC73 2A 04                          bpl loc_EC79                        ; EC73  2A 04         if [X+0] >= 0 (signed) goto loc_EC79
21883:     EC75 40                             nega                                ; EC75  40            A = -A
21884:     EC76 50                             negb                                ; EC76  50            B = -B
21885:     EC77 82 00                          sbca #$00                           ; EC77  82 00         A -= C + 0
21886:     EC79                        loc_EC79:
21887:     EC79 31                             ins                                 ; EC79  31            SP++
