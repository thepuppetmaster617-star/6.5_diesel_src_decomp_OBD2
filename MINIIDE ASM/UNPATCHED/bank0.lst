 1891:                                 ; ISR_RTI_EEPROM_write_6614
 1892:                                 ;   analysis [high]: RTI interrupt (vector FFF0). Background EEPROM byte-write state machine, one step per RTI
 1893:                                 ;        tick: writes byte [$59] to $0E00+[$58] when request $57.1 is set. Does a byte erase first only when new
 1894:                                 ;        data needs a 0->1 bit; verifies with EEPROM_program_byte, then clears the request.
 1895:                                 ; ----------------------------------------------------------------------------
 1896:     6614                        ISR_RTI_EEPROM_write_6614:
 1897:     6614 13 57 02 51                    brclr <sys_state_flags,$02,loc_6669 ; 6614  13 57 02 51   if sys_state_flags .1 EEPROM byte rewrite pending ($58/$59) clear goto loc_6669 | $57.1 = EEPROM write request; $58 = offset into EEPROM $0E00, $59 = data (set at 5CEC)
 1898:     6618 CE 0E00                        ldx #eeprom_security_seed           ; 6618  CE 0E 00      X = &eeprom_security_seed
 1899:     661B D6 58                          ldab <EEPROM_write_offset           ; 661B  D6 58         B = EEPROM_write_offset
 1900:     661D 3A                             abx                                 ; 661D  3A            X += B
 1901:     661E B6 103B                        ldaa >PPROG                         ; 661E  B6 10 3B      A = PPROG | PPROG=3 (EELAT|EEPGM): program cycle running -> finish, verify and clear request
 1902:     6621 81 03                          cmpa #$03                           ; 6621  81 03         compare A with 3
 1903:     6623 27 33                          beq loc_6658                        ; 6623  27 33         if PPROG == 3 goto loc_6658
 1904:     6625 85 04                          bita #$04                           ; 6625  85 04         test PPROG .2 | PPROG.2 ERASE set: erase cycle finished -> verify $FF, then start programming
 1905:     6627 26 1A                          bne loc_6643                        ; 6627  26 1A         if any of PPROG .2 set goto loc_6643
 1906:     6629 E6 00                          ldab $00,x                          ; 6629  E6 00         B = [X+0] | erase needed only if new data needs a bit 0->1 (~old & new != 0)
 1907:     662B 53                             comb                                ; 662B  53            B = ~B
 1908:     662C D4 59                          andb <EEPROM_write_value            ; 662C  D4 59         B &= EEPROM_write_value
 1909:     662E 27 18                          beq loc_6648                        ; 662E  27 18         if B == 0 goto loc_6648
 1910:     6630 86 02                          ldaa #$02                           ; 6630  86 02         A = 2 | start byte erase: $16 = BYTE|ERASE|EELAT, then $17 turns on EEPGM
 1911:     6632 B7 103B                        staa >PPROG                         ; 6632  B7 10 3B      PPROG = A
 1912:     6635 86 16                          ldaa #$16                           ; 6635  86 16         A = $16(22)
 1913:     6637 B7 103B                        staa >PPROG                         ; 6637  B7 10 3B      PPROG = A
 1914:     663A E7 00                          stab $00,x                          ; 663A  E7 00         [X+0] = B
 1915:     663C 86 17                          ldaa #$17                           ; 663C  86 17         A = $17(23)
 1916:     663E B7 103B                        staa >PPROG                         ; 663E  B7 10 3B      PPROG = A
 1917:     6641 20 26                          bra loc_6669                        ; 6641  20 26         goto loc_6669
 1918:     6643                        loc_6643:
 1919:     6643 86 FF                          ldaa #$FF                           ; 6643  86 FF         A = $FF(255)
 1920:     6645 BD 642C                        jsr >EEPROM_program_byte            ; 6645  BD 64 2C      call EEPROM_program_byte
 1921:     6648                        loc_6648:
 1922:     6648 D6 59                          ldab <EEPROM_write_value            ; 6648  D6 59         B = EEPROM_write_value | program cycle: EELAT, latch data, then EELAT|EEPGM; completes on next RTI
 1923:     664A 86 02                          ldaa #$02                           ; 664A  86 02         A = 2
 1924:     664C B7 103B                        staa >PPROG                         ; 664C  B7 10 3B      PPROG = A
 1925:     664F E7 00                          stab $00,x                          ; 664F  E7 00         [X+0] = B
 1926:     6651 86 03                          ldaa #$03                           ; 6651  86 03         A = 3
 1927:     6653 B7 103B                        staa >PPROG                         ; 6653  B7 10 3B      PPROG = A
 1928:     6656 20 11                          bra loc_6669                        ; 6656  20 11         goto loc_6669
 1929:     6658                        loc_6658:
 1930:     6658 96 59                          ldaa <EEPROM_write_value            ; 6658  96 59         A = EEPROM_write_value
 1931:     665A BD 642C                        jsr >EEPROM_program_byte            ; 665A  BD 64 2C      call EEPROM_program_byte
 1932:     665D 7F 103B                        clr >PPROG                          ; 665D  7F 10 3B      PPROG = 0
 1933:     6660 15 57 02                       bclr <sys_state_flags,$02           ; 6660  15 57 02      sys_state_flags .1 EEPROM byte rewrite pending ($58/$59) = 0
 1934:     6663 7F 0058                        clr >EEPROM_write_offset            ; 6663  7F 00 58      EEPROM_write_offset = 0
