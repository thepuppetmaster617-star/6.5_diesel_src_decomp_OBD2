 5606:                                 ; ----------------------------------------------------------------------------
 5607:                                 ; Verify_spill_valve_timing
 5608:                                 ;   analysis [high]: Reads the TIO closure time (1472) into MEAS_INJ_RSP_196740_RAW. A zero, too short (<kw_2759)
 5609:                                 ;        or repeated reading counts up a stale counter 00B2; after k_2755 bad reads the closure time is zeroed.
 5610:                                 ;        FLAGS2.4 is set when the response is outside CAL_diag_MINRSP..MAXRSP. Also computes MEASURED_INJ_TMG_8192
 5611:                                 ;        = TIO 146C angle + TDC_REF_OFFSET, clamped 0..CAL_SOL_MAX_PUMP_TIMING.
 5612:                                 ;   OBD1 read_closure_time (match 1.00 p1-exact)
 5613:                                 ;   called from: run_6ms_job
 5614:                                 ; ----------------------------------------------------------------------------
 5615:     A74C                        Verify_spill_valve_timing:
 5616:     A74C 0F                             sei                                 ; A74C  0F            disable interrupts
 5617:     A74D B6 1472                        ldaa >closure_time_response         ; A74D  B6 14 72      A = closure_time_response
 5618:     A750 0E                             cli                                 ; A750  0E            enable interrupts
 5619:     A751 FC 1472                        ldd >closure_time_response          ; A751  FC 14 72      D = closure_time_response | OBD1: pulse width from fuel pump
 5620:     A754 DD 3A                          std <MEAS_INJ_RSP_196740_RAW        ; A754  DD 3A         MEAS_INJ_RSP_196740_RAW = D | OBD1: delay from energize to close
 5621:     A756 27 1C                          beq b1_loc_A774                     ; A756  27 1C         if D == 0 goto b1_loc_A774
 5622:     A758 1AB3 2759                      cpd >kw_2759                        ; A758  1A B3 27 59   compare D with kw_2759 | OBD1: set to $0064 or 0.508ms
 5623:     A75C 25 16                          bcs b1_loc_A774                     ; A75C  25 16         if closure_time_response < kw_2759 goto b1_loc_A774
 5624:     A75E 1A93 BB                        cpd <LAST_MEASURED_CLOSURE          ; A75E  1A 93 BB      compare D with LAST_MEASURED_CLOSURE
 5625:     A761 27 02                          beq b1_loc_A765                     ; A761  27 02         if closure_time_response == LAST_MEASURED_CLOSURE goto b1_loc_A765
 5626:     A763 20 25                          bra b1_loc_A78A                     ; A763  20 25         goto b1_loc_A78A
 5627:     A765                        b1_loc_A765:
 5628:     A765 FC 1986                        ldd >engine_RPM                     ; A765  FC 19 86      D = engine_RPM
 5629:     A768 1AB3 2753                      cpd >k_zero_fuel_rise_min_RPM_2753  ; A768  1A B3 27 53   compare D with k_zero_fuel_rise_min_RPM_2753 | OBD1: set to $500a     ... BUG!!! but doesn't really matter much.
 5630:     A76C 25 1C                          bcs b1_loc_A78A                     ; A76C  25 1C         if engine_RPM < k_zero_fuel_rise_min_RPM_2753 goto b1_loc_A78A
