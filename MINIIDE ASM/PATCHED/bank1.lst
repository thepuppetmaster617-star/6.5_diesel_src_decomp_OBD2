 3642:     9AB2 58                             aslb                                ; 9AB2  58            B <<= 1
 3643:     9AB3 F1 200E                        cmpb >CAL_CYLBAL_PACETMR            ; 9AB3  F1 20 0E      compare B with CAL_CYLBAL_PACETMR
 3644:     9AB6 25 01                          bcs b1_loc_9AB9                     ; 9AB6  25 01         if CAL_CYLBAL_PACETMR < CAL_CYLBAL_PACETMR goto b1_loc_9AB9
 3645:     9AB8 08                             inx                                 ; 9AB8  08            X++
