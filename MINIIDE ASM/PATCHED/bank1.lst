 3591:     9A6C 58                             aslb                                ; 9A6C  58            B <<= 1
 3592:     9A6D 3A                             abx                                 ; 9A6D  3A            X += B
 3593:     9A6E FC 1982                        ldd >RPM_RAW                        ; 9A6E  FC 19 82      D = RPM_RAW
