 5633:     A774                        b1_loc_A774:
 5634:     A774 96 B2                          ldaa <closure_stale_ctr             ; A774  96 B2         A = closure_stale_ctr | bad/stale closure reading: count up; after k_2755 in a row zero the closure time
 5635:     A776 81 FF                          cmpa #$FF                           ; A776  81 FF         compare A with $FF(255)
 5636:     A778 27 13                          beq b1_loc_A78D                     ; A778  27 13         if closure_stale_ctr == $FF(255) goto b1_loc_A78D
