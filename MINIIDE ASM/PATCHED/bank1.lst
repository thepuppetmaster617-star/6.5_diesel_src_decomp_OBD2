 1054:                                 ; ----------------------------------------------------------------------------
 1055:                                 ; FIRE_BACKUP_INJ_OUTPUT
 1056:                                 ;   analysis [medium]: Backup (low-res limp) injection pulse scheduler (OBD1 FIRE_BACKUP_INJ_OUTPUT), called from
 1057:                                 ;        both ISRs and from 8F03/8F86. It sets $5A.7 and presets the PA5/PA4 output levels. Delay = (filtered
 1058:                                 ;        period $1954 - INJ_RESPONSE_230556)*16, minus PUMP_TO_TDC_TIME_BKUP when cam-referenced, as a 24-bit
 1059:                                 ;        value. TOC4 is set from the reference edge (CKP $196B, or cam TIC_CAP_RPM when P0251 is current) with an
 1060:                                 ;        ov
 1061:                                 ;   OBD1 FIRE_BACKUP_INJ_OUTPUT (match 1.00 p1-exact): Fired in CKP routine
 1062:                                 ;   called from: CKP_4X_input_capture_isr_81E3, diag_P0251_P0335_890E, TOC4_BKUP_INJ_INT
 1063:                                 ; ----------------------------------------------------------------------------
 1064:     87FF                        FIRE_BACKUP_INJ_OUTPUT:
 1065:     87FF 14 5A 80                       bset <crank_ITS_flags,$80           ; 87FF  14 5A 80      crank_ITS_flags .7 = 1 | $5A.7 = backup injection mode active; preset PA5 low / PA4 high (OC3/OC4 pins) | OBD1: run its home sequence if in backup mode
 1066:     8802 B6 1000                        ldaa >PORTA                         ; 8802  B6 10 00      A = PORTA
 1067:     8805 84 DF                          anda #$DF                           ; 8805  84 DF         A &= $DF(223) (keep bits) | OBD1: set OC4 low if no action
 1068:     8807 B7 1000                        staa >PORTA                         ; 8807  B7 10 00      PORTA = A
 1069:     880A B6 1000                        ldaa >PORTA                         ; 880A  B6 10 00      A = PORTA
 1070:     880D 8A 10                          oraa #$10                           ; 880D  8A 10         A |= $10(16) | OBD1: set OC2 high if no action
 1071:     880F B7 1000                        staa >PORTA                         ; 880F  B7 10 00      PORTA = A
