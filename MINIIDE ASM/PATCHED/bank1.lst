 3584:     9A5B B7 18F0                        staa >CYLBAL_LAST_CYLC7             ; 9A5B  B7 18 F0      CYLBAL_LAST_CYLC7 = A
 3585:     9A5E BD 9A8E                        jsr >CYLBAL_CLEAR_ACCEL             ; 9A5E  BD 9A 8E      call CYLBAL_CLEAR_ACCEL
 3586:     9A61 14 4C 04                       bset <ENGMODEFLAG,$04               ; 9A61  14 4C 04      ENGMODEFLAG .2 cylinder balance accumulation started = 1
 3587:     9A64 20 27                          bra b1_loc_9A8D                     ; 9A64  20 27         goto b1_loc_9A8D
 3588:     9A66                        b1_loc_9A66:
