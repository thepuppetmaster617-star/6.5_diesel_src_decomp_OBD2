 3573:                                 ; ----------------------------------------------------------------------------
 3574:                                 ; DO_CYLBAL
 3575:                                 ;   analysis [high]: Cylinder balance accumulator, run each idle-governor pass: first pass clears sums; afterwards
 3576:                                 ;        adds RPM_RAW into the per-cylinder sum slot (CYLBAL_STOR_CYL) and, after CAL_CYLBAL_PACETMR cycles, runs
 3577:                                 ;        CYLBAL_ADJUST_AND_DIAG and restarts.
 3578:                                 ;   OBD1 DO_CYLBAL (match 1.00 p1-exact): done crank synchronous job
 3579:                                 ;   called from: IDLE_MODE_GOVERNOR
 3580:                                 ; ----------------------------------------------------------------------------
 3581:     9A54                        DO_CYLBAL:
 3582:     9A54 12 4C 04 0E                    brset <ENGMODEFLAG,$04,b1_loc_9A66  ; 9A54  12 4C 04 0E   if ENGMODEFLAG .2 cylinder balance accumulation started set goto b1_loc_9A66
